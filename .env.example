# Copiar para `.env` e preencher. As mesmas variáveis vão para o Vercel:
# Project Settings → Environment Variables.

# Chave API Resend (resend.com/api-keys)
RESEND_API_KEY=

# Remetente. O domínio tem de estar verificado no Resend.
# Sem domínio: "SRF <onboarding@resend.dev>" (só entrega ao email da conta Resend).
EMAIL_FROM="SRF <onboarding@resend.dev>"

# Destinatário dos pedidos.
EMAIL_TO=contacto@srf-cryorecovery.com
