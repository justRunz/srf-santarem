---
// 3 cartes : durée fixe, texte de la page.
const { itens } = Astro.props;
const fixos = [
  { dur: '15', un: 'dias' },
  { dur: '1', un: 'mês' },
  { dur: '+30', un: 'dias' },
];
---
<div class="cards">
  {itens.slice(0, 3).map((it, i) => (
    <div class={`card reveal${i === 1 ? ' featured' : ''}`} style={i ? `--d:${i / 10}s` : undefined}>
      <div class="dur">{fixos[i].dur} <small>{fixos[i].un}</small></div>
      <h3>{it.nome}</h3>
      <p>{it.texto}</p>
    </div>
  ))}
</div>
