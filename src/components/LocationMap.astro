---
// OpenStreetMap (Leaflet) map instead of the Google iframe: no tracking cookies.
// The « © OpenStreetMap » credit is mandatory (ODbL licence).
import site from '../data/site.json';
const address = `${site.address}, ${site.postalCode}`;
---
<div class="map reveal" data-map data-lat={site.lat} data-lon={site.lon} data-name={site.acronym} role="img" aria-label={`Mapa: ${address}`}></div>

<style>
  .map{width:100%;aspect-ratio:1;border-radius:20px;overflow:hidden;background:#efece8;z-index:0}
  .map :global(.leaflet-tile-pane){filter:saturate(.75) contrast(.95)}
  .map :global(.leaflet-container){font-family:inherit;background:#efece8}
  .map :global(.leaflet-control-attribution){background:none;font-size:10px;color:var(--ash)}
  .map :global(.leaflet-control-attribution a){color:inherit}
  .map :global(.leaflet-control-zoom){border:0;box-shadow:0 8px 24px -12px rgba(0,13,16,.35)}
  .map :global(.map-pin){display:block;width:18px;height:18px;border-radius:50%;background:var(--ink);box-shadow:0 0 0 4px #fff,0 0 0 10px rgba(0,13,16,.18)}
  .map :global(.map-tip){padding:4px 12px;border:0;border-radius:999px;background:var(--ink);color:#fff;font-weight:600;box-shadow:none}
  .map :global(.map-tip::before){display:none}
</style>

<script>
  const el = document.querySelector<HTMLElement>('[data-map]');
  if (el) {
    // Only load Leaflet once the map gets close to the viewport
    const io = new IntersectionObserver(async (entries) => {
      if (!entries.some((e) => e.isIntersecting)) return;
      io.disconnect();
      const [{ default: L }] = await Promise.all([import('leaflet'), import('leaflet/dist/leaflet.css')]);
      const pos: [number, number] = [Number(el.dataset.lat), Number(el.dataset.lon)];
      const map = L.map(el, { scrollWheelZoom: false }).setView(pos, 14);
      map.attributionControl.setPrefix(false);
      L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
        maxZoom: 19,
        attribution: '© <a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noopener">OpenStreetMap</a>',
      }).addTo(map);
      const pin = L.divIcon({ className: '', html: '<span class="map-pin"></span>', iconSize: [18, 18], iconAnchor: [9, 9] });
      L.marker(pos, { icon: pin, keyboard: false })
        .bindTooltip(el.dataset.name ?? '', { permanent: true, direction: 'bottom', className: 'map-tip', offset: [0, 12] })
        .addTo(map);
    }, { rootMargin: '400px' });
    io.observe(el);
  }
</script>
