---
import Lines from './Lines.astro';
const { data } = Astro.props;
const texts = data.texts ?? [data.text];
---
<section class="dark">
  <div class:list={["wrap", data.photo && "with-photo"]}>
    {data.photo && <img class="highlight-photo reveal" src={data.photo} alt="" loading="lazy">}
    <div class="right">
      {data.eyebrow && <span class="eyebrow reveal">{data.eyebrow}</span>}
      <Lines class="h-md" lines={data.title} />
      {texts.map((t, i) => <p class="reveal" style={i ? undefined : 'margin-top:28px'}>{t}</p>)}
      <div class="pills reveal" style="margin-top:32px"><slot /></div>
    </div>
  </div>
</section>
