---
import Lines from './Lines.astro';
const { data } = Astro.props;
const texts = data.texts ?? [data.text];
---
<section class="dark">
  <div class:list={["wrap", data.photo ? "with-photo" : "split"]}>
    {data.photo && <img class="highlight-photo reveal" src={data.photo} alt="" loading="lazy">}
    <div class="right">
      <div>
        {data.eyebrow && <span class="eyebrow reveal">{data.eyebrow}</span>}
        <Lines class="h-md" lines={data.title} />
      </div>
      <div class="body">
        {texts.map((t) => <p class="reveal">{t}</p>)}
        <div class="pills reveal" style="margin-top:var(--sp-4)"><slot /></div>
      </div>
    </div>
  </div>
</section>
