---
const { items } = Astro.props;
---
<div class="carousel reveal">
  <h3 class="car-title" aria-live="polite">{items[0]?.title}</h3>
  <div class="track">
    {items.map((it) => (
      <div class="slide" data-title={it.title}>
        {it.photo ? <img src={it.photo} alt={it.title} loading="lazy" /> : <span class="ph-label">Foto · {it.title.toLowerCase()}</span>}
      </div>
    ))}
  </div>
  <div class="car-ctrl"><button class="prev" aria-label="Anterior"><svg width="1em" height="1em" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5M11 6l-6 6 6 6"/></svg></button><button class="next" aria-label="Seguinte"><svg width="1em" height="1em" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></button><span class="count">1/{items.length}</span></div>
</div>
