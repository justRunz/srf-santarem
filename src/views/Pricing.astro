---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import Highlight from '../components/Highlight.astro';
import p from '../data/pricing.json';
const r = p.rates;
const stats = [
  [r.fifteenDays, '15 dias mínimo', true],
  [r.extraDay, 'por dia extra a partir do 16.º dia'],
  [r.month, 'mês completo (30 dias)', true],
];
---
<Layout title="Preços e Entregas">
  <PageHero slot="hero" hero={p.hero}>
    <div class="pills reveal" style="--d:.4s"><a class="pill" href="/contactos#reservar">Reservar</a></div>
  </PageHero>
  <section>
    <div class="wrap">
      <div class="stats">
        {stats.map(([n, l, vat]) => <div class="stat"><b data-count={n} data-suffix=" €">{n} €</b><small class="vat" style={vat ? undefined : "visibility:hidden"} aria-hidden={vat ? undefined : "true"}>s / IVA</small><span>{l}</span></div>)}
      </div>
      <div class="price-list">
        {p.groups.map((g, i) => (
          <div class="price-group reveal">
            <h3>{g.title}</h3>
            {g.rows.map((row) => <div class="row"><span>{row.name}</span><b>{row.value}</b></div>)}
            {i === 0 && <div class="row"><span>Caução</span><b>{r.deposit ? `${r.deposit} €` : 'Não exigida'} ({p.depositTerms})</b></div>}
          </div>
        ))}
      </div>
    </div>
  </section>
  <Highlight data={p.highlight}><a class="pill light" href="/contactos#reservar">Reservar</a></Highlight>
</Layout>
