---
import '@fontsource-variable/inter-tight';
import site from '../data/site.json';
const { title } = Astro.props;
import { tel } from '../lib.js';
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const nav = [['/', 'Início'], ['/beneficios', 'Benefícios'], ['/equipamentos', 'Equipamentos'], ['/precos', 'Preços e Entregas'], ['/contactos', 'Contactos']];
---
<!doctype html>
<html lang="pt-PT">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{title} · {site.acronym} Santarém</title>
<meta name="description" content={site.description}>
<link rel="stylesheet" href="/style.css">
<link rel="icon" type="image/png" href="/favicon.png">
</head>
<body>
<div class="sky">
<header>
  <div class="wrap">
    <a class="brand" href="/"><img class="logo" src="/img/logo.png" alt={`${site.acronym} — ${site.name}`} width="640" height="183"></a>
    <button class="menu-btn" aria-label="Menu" aria-expanded="false">≡</button>
    <nav>
      {nav.map(([href, label]) => <a href={href} aria-current={path === href ? 'page' : undefined}>{label}</a>)}
    </nav>
  </div>
</header>
<slot name="hero" />
</div>
<main>
<slot />
</main>
<footer>
  <div class="wrap">
    <div class="cols">
      <div>
        <h3>{site.name}</h3>
        <p>{site.footer.map((l, i) => <>{i > 0 && <br />}{l}</>)}</p>
        <div class="pills" style="margin-top:20px"><a class="pill light" href="/contactos#reservar">Reservar</a></div>
      </div>
      <div>
        <h3>Contacto</h3>
        <p><a href={tel}>{site.phone}</a><br><a href={`mailto:${site.email}`}>{site.email}</a><br>{site.address}<br>{site.postalCode}</p>
      </div>
      <div>
        <h3>Horário</h3>
        <p>{site.hours.map((l, i) => <>{i > 0 && <br />}{l}</>)}</p>
      </div>
    </div>
    <div class="foot-mark">{site.acronym}</div>
    <div class="legal"><span>© {new Date().getFullYear()} {site.name}</span><span><a href="/termos">Termos e condições</a> · <a href="/privacidade">Privacidade</a> · <a href="https://www.livroreclamacoes.pt" rel="noopener">Livro de Reclamações</a></span></div>
  </div>
</footer>
<script is:inline src="/script.js"></script>
</body>
</html>
