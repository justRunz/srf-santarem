---
import Layout from '../layouts/Layout.astro';
import Lines from '../components/Lines.astro';
import Carousel from '../components/Carousel.astro';
import Pacotes from '../components/Pacotes.astro';
import Destaque from '../components/Destaque.astro';
import p from '../data/inicio.json';
import precos from '../data/precos.json';
const t = precos.tarifas;
import { wa } from '../lib.js';
---
<Layout titulo="Início">
  <div class="wrap hero" slot="hero">
    <div class="hero-text">
      <span class="eyebrow reveal">{p.hero.eyebrow}</span>
      <Lines tag="h1" class="hero-title" linhas={p.hero.titulo} />
      <p class="hero-lead reveal" style="--d:.35s">{p.hero.texto}</p>
      <div class="pills reveal" style="--d:.45s">
        <a class="pill" href={wa}>Reservar pelo WhatsApp</a>
        <a class="pill ghost" href="/precos">Ver preços</a>
      </div>
      <ul class="trust reveal" style="--d:.55s">
        <li>Entrega grátis em Santarém</li>
        <li>Desde {t.quinzeDias} € / 15 dias</li>
        <li>{t.caucao ? `${t.caucao} € de caução` : 'Sem caução'}</li>
      </ul>
    </div>
    <div class="hero-media">
      <video src="/video/hero.mp4" poster="/video/hero.jpg" autoplay muted loop playsinline aria-hidden="true"></video>
    </div>
    <script is:inline>if(matchMedia('(prefers-reduced-motion:reduce)').matches)document.querySelector('.hero-media video').removeAttribute('autoplay')</script>
  </div>

  <section>
    <div class="wrap">
      <span class="eyebrow reveal">{p.intro.eyebrow}</span>
      <Lines class="h-lg" linhas={p.intro.titulo} />
      <p class="lead reveal" style="--d:.3s">{p.intro.texto}</p>
    </div>
  </section>

  <section style="padding-top:0">
    <div class="wrap features">
      {p.pontos.map((f, i) => <div class="feature reveal" style={i % 2 ? '--d:.1s' : undefined}><h3>{f.titulo}</h3><p>{f.texto}</p></div>)}
    </div>
  </section>

  <section style="padding-top:0">
    <div class="wrap stats">
      <div class="stat"><b data-count="15">15</b><span>dias de aluguer mínimo</span></div>
      <div class="stat"><b data-count={t.quinzeDias} data-suffix=" €">{t.quinzeDias} €</b><span>por 15 dias, tudo incluído</span></div>
      <div class="stat">{t.caucao ? <><b data-count={t.caucao} data-suffix=" €">{t.caucao} €</b><span>de caução</span></> : <><b>Sem</b><span>caução</span></>}</div>
      <div class="stat"><b data-count="1" data-suffix=" h">1 h</b><span>resposta máxima em casos urgentes</span></div>
    </div>
  </section>

  <section style="padding-top:0">
    <div class="wrap">
      <div class="head-row">
        <Lines class="h-md" linhas={p.kit.titulo} />
        <a class="pill ghost reveal" href="/equipamentos">Ver equipamentos</a>
      </div>
      <Carousel itens={p.kit.itens} />
    </div>
  </section>

  <section style="padding-top:0">
    <div class="wrap">
      <div class="head-row">
        <Lines class="h-md" linhas={p.pacotes.titulo} />
        <a class="pill ghost reveal" href="/precos">Preços e entregas</a>
      </div>
      <Pacotes itens={p.pacotes.itens} comPreco />
    </div>
  </section>

  <section style="padding-top:0">
    <div class="wrap">
      <span class="eyebrow reveal">{p.passos.eyebrow}</span>
      <div class="features three">
        {p.passos.itens.map((f, i) => <div class="feature reveal" style={i ? `--d:${i / 10}s` : undefined}><span class="n">{String(i + 1).padStart(2, '0')}</span><h3>{f.titulo}</h3><p>{f.texto}</p></div>)}
      </div>
    </div>
  </section>

  <Destaque d={p.sobre}><a class="pill light" href="/contactos">Reservar o seu equipamento</a><a class="pill light-ghost" href="/beneficios">Benefícios</a></Destaque>
</Layout>
