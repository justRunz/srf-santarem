---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import Destaque from '../components/Destaque.astro';
import p from '../data/precos.json';
import { wa } from '../lib.js';
const t = p.tarifas;
const stats = [
  [t.quinzeDias, '15 dias (mínimo)'],
  [t.diaExtra, 'por dia extra, do 16.º ao 30.º'],
  [t.mes, 'mês completo (30 dias)'],
  [t.diaAposMes, 'por dia, após o 1.º mês'],
];
---
<Layout titulo="Preços e Entregas">
  <PageHero slot="hero" hero={p.hero}>
    <div class="pills reveal" style="--d:.4s"><a class="pill" href={wa}>Reservar pelo WhatsApp</a><a class="pill ghost" href="/contactos">Contactos</a></div>
  </PageHero>
  <section>
    <div class="wrap">
      <div class="stats" style="margin-bottom:clamp(72px,10vw,140px)">
        {stats.map(([n, l]) => <div class="stat"><b data-count={n} data-suffix=" €">{n} €</b><span>{l}</span></div>)}
      </div>
      <div class="price-list">
        {p.grupos.map((g, i) => (
          <div class="price-group reveal">
            <h3>{g.titulo}</h3>
            {g.linhas.map((r) => <div class="row"><span>{r.nome}</span><b>{r.valor}</b></div>)}
            {i === 0 && <div class="row"><span>Caução</span><b>{t.caucao} € ({p.condicoesCaucao})</b></div>}
          </div>
        ))}
      </div>
    </div>
  </section>
  <Destaque d={p.destaque}><a class="pill light" href={wa}>Reservar pelo WhatsApp</a><a class="pill light-ghost" href="/contactos">Contactos</a></Destaque>
</Layout>
