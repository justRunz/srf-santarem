---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import Destaque from '../components/Destaque.astro';
import p from '../data/beneficios.json';
---
<Layout titulo="Benefícios">
  <PageHero slot="hero" hero={p.hero} />
  <section>
    <div class="wrap features">
      {p.pontos.map((f, i) => <div class="feature reveal" style={i % 2 ? '--d:.1s' : undefined}><span class="n">{String(i + 1).padStart(2, '0')}</span><h3>{f.titulo}</h3><p>{f.texto}</p></div>)}
    </div>
  </section>
  <Destaque d={p.destaque}><a class="pill light" href="/contactos">Falar connosco</a></Destaque>
</Layout>
