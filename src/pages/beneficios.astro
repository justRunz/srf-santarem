---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import Highlight from '../components/Highlight.astro';
import p from '../data/benefits.json';
---
<Layout title="Benefícios">
  <PageHero slot="hero" hero={p.hero} />
  <section>
    <div class="wrap features">
      {p.points.map((f, i) => <div class="feature reveal" style={i % 2 ? '--d:.1s' : undefined}><span class="n">{String(i + 1).padStart(2, '0')}</span><h3>{f.title}</h3><p>{f.text}</p></div>)}
    </div>
  </section>
  <Highlight data={p.highlight}><a class="pill light" href="/contactos">Falar connosco</a></Highlight>
</Layout>
